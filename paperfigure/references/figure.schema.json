{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaperFigure semantic and visual contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "kind": {
            "enum": [
              "user-description",
              "paper",
              "code",
              "reference-image"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "locator",
          "text"
        ]
      },
      "minItems": 1
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "innovation": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseline": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "summary",
        "innovation",
        "baseline",
        "scope"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          },
          "role": {
            "enum": [
              "input",
              "output",
              "encoder",
              "core",
              "memory",
              "tool",
              "environment",
              "loss",
              "neutral"
            ]
          },
          "status": {
            "enum": [
              "baseline",
              "proposed",
              "neutral"
            ]
          },
          "phase": {
            "enum": [
              "train",
              "inference",
              "both"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source",
                "quote"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "label",
          "role",
          "status",
          "phase",
          "evidence"
        ]
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "data",
              "control",
              "feedback"
            ]
          },
          "status": {
            "enum": [
              "baseline",
              "proposed",
              "neutral"
            ]
          },
          "phase": {
            "enum": [
              "train",
              "inference",
              "both"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source",
                "quote"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "status",
          "phase",
          "evidence"
        ]
      },
      "minItems": 0
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "minItems": 1
          },
          "parent": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          }
        },
        "required": [
          "id",
          "label",
          "members"
        ]
      },
      "minItems": 0
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "number",
              "minimum": 640,
              "maximum": 4096
            },
            "height": {
              "type": "number",
              "minimum": 360,
              "maximum": 4096
            }
          },
          "required": [
            "width",
            "height"
          ]
        },
        "direction": {
          "enum": [
            "LR",
            "TB"
          ]
        },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "fontSize": {
                "type": "number",
                "minimum": 12,
                "maximum": 48
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ]
          }
        },
        "edges": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fromPort": {
                "enum": [
                  "left",
                  "right",
                  "top",
                  "bottom"
                ]
              },
              "toPort": {
                "enum": [
                  "left",
                  "right",
                  "top",
                  "bottom"
                ]
              },
              "via": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 0
              },
              "label": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              },
              "fromFraction": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 0.9
              },
              "toFraction": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 0.9
              }
            },
            "required": []
          }
        }
      },
      "required": [
        "canvas",
        "direction"
      ]
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "enum": [
            "paper",
            "mono"
          ]
        },
        "publicationWidthIn": {
          "type": "number",
          "minimum": 2,
          "maximum": 20
        },
        "minTextPt": {
          "type": "number",
          "minimum": 5,
          "maximum": 20
        },
        "showTitle": {
          "type": "boolean",
          "default": false
        },
        "showSubtitle": {
          "type": "boolean",
          "default": false
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fontFamily": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9 _-]+$"
            },
            "moduleSize": {
              "type": "number",
              "minimum": 12,
              "maximum": 60
            },
            "detailSize": {
              "type": "number",
              "minimum": 12,
              "maximum": 60
            },
            "annotationSize": {
              "type": "number",
              "minimum": 12,
              "maximum": 60
            },
            "titleSize": {
              "type": "number",
              "minimum": 12,
              "maximum": 60
            },
            "moduleBold": {
              "type": "boolean"
            }
          }
        },
        "nodeGlyphs": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "image",
              "stack",
              "memory",
              "tools"
            ]
          }
        },
        "showLegend": {
          "type": "boolean",
          "default": false
        },
        "appearances": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodes": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "fill": {
                    "type": "string",
                    "pattern": "^(#[0-9A-Fa-f]{6}|none)$"
                  },
                  "stroke": {
                    "type": "string",
                    "pattern": "^(#[0-9A-Fa-f]{6}|none)$"
                  },
                  "radius": {
                    "type": "number",
                    "minimum": 0
                  },
                  "strokeWidth": {
                    "type": "number",
                    "minimum": 0.1
                  },
                  "label": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "w": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "align": {
                        "enum": [
                          "left",
                          "center",
                          "right"
                        ]
                      },
                      "bold": {
                        "type": "boolean"
                      },
                      "fontFamily": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9 _-]+$"
                      },
                      "italic": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "w"
                    ]
                  },
                  "detail": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "w": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "align": {
                        "enum": [
                          "left",
                          "center",
                          "right"
                        ]
                      },
                      "bold": {
                        "type": "boolean"
                      },
                      "fontFamily": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9 _-]+$"
                      },
                      "italic": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "w"
                    ]
                  },
                  "gradient": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "from": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "to": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "direction": {
                        "enum": [
                          "horizontal",
                          "vertical"
                        ]
                      }
                    },
                    "required": [
                      "from",
                      "to",
                      "direction"
                    ]
                  },
                  "hideLabel": {
                    "type": "boolean"
                  },
                  "hideDetail": {
                    "type": "boolean"
                  }
                },
                "required": []
              }
            },
            "groups": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "fill": {
                    "type": "string",
                    "pattern": "^(#[0-9A-Fa-f]{6}|none)$"
                  },
                  "stroke": {
                    "type": "string",
                    "pattern": "^(#[0-9A-Fa-f]{6}|none)$"
                  },
                  "radius": {
                    "type": "number",
                    "minimum": 0
                  },
                  "dashed": {
                    "type": "boolean"
                  },
                  "strokeWidth": {
                    "type": "number",
                    "minimum": 0.1
                  }
                },
                "required": []
              }
            },
            "edges": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "stroke": {
                    "type": "string",
                    "pattern": "^(#[0-9A-Fa-f]{6}|none)$"
                  },
                  "strokeWidth": {
                    "type": "number",
                    "minimum": 0.1
                  },
                  "labelBackground": {
                    "type": "boolean"
                  }
                },
                "required": []
              }
            }
          },
          "required": []
        },
        "artwork": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "owner": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "rect",
                  "ellipse",
                  "line",
                  "text",
                  "asset"
                ]
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              },
              "fill": {
                "type": "string",
                "pattern": "^(#[0-9A-Fa-f]{6}|none)$"
              },
              "stroke": {
                "type": "string",
                "pattern": "^(#[0-9A-Fa-f]{6}|none)$"
              },
              "strokeWidth": {
                "type": "number",
                "minimum": 0.1
              },
              "radius": {
                "type": "number",
                "minimum": 0
              },
              "text": {
                "type": "string"
              },
              "fontSize": {
                "type": "number",
                "minimum": 12
              },
              "bold": {
                "type": "boolean"
              },
              "align": {
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              },
              "asset": {
                "type": "string"
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "textBackground": {
                "type": "boolean"
              },
              "gradient": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "direction": {
                    "enum": [
                      "horizontal",
                      "vertical"
                    ]
                  }
                },
                "required": [
                  "from",
                  "to",
                  "direction"
                ]
              },
              "fontFamily": {
                "type": "string",
                "pattern": "^[A-Za-z0-9 _-]+$"
              },
              "italic": {
                "type": "boolean"
              },
              "runs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "subscript": {
                      "type": "boolean"
                    },
                    "italic": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "text"
                  ]
                }
              },
              "crop": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  },
                  "w": {
                    "type": "number",
                    "minimum": 1
                  },
                  "h": {
                    "type": "number",
                    "minimum": 1
                  },
                  "sourceWidth": {
                    "type": "number",
                    "minimum": 1
                  },
                  "sourceHeight": {
                    "type": "number",
                    "minimum": 1
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h",
                  "sourceWidth",
                  "sourceHeight"
                ]
              }
            },
            "required": [
              "id",
              "owner",
              "type",
              "x",
              "y",
              "w",
              "h",
              "purpose"
            ]
          }
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "target",
                "inspiration"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "mode",
            "path",
            "sha256"
          ]
        }
      },
      "required": [
        "theme",
        "publicationWidthIn",
        "minTextPt"
      ]
    }
  },
  "required": [
    "version",
    "title",
    "subtitle",
    "sources",
    "claims",
    "assumptions",
    "nodes",
    "edges",
    "groups",
    "layout",
    "visual"
  ]
}
