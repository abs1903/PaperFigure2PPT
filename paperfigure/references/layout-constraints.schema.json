{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaperFigure editable layout constraint scene",
  "type": "object",
  "required": [
    "version",
    "width",
    "height",
    "modules",
    "edges",
    "primitives",
    "labels"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "title": {
      "type": "string"
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "height": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "source": {
      "type": "object"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "box"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "box": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "parent": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "container": {
            "type": "boolean"
          },
          "routingObstacle": {
            "type": "boolean"
          },
          "anchorShapeId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "sourceStart": {
            "type": "number"
          },
          "textBox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "centerTextIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            }
          },
          "centerTolerance": {
            "type": "number"
          },
          "minPadding": {
            "type": "number",
            "minimum": 0
          },
          "minFontScale": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1
          },
          "aboveEdges": {
            "type": "boolean"
          },
          "captionIncluded": {
            "type": "boolean"
          },
          "semanticRole": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "points",
          "stroke",
          "width"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "from": {
            "type": "object",
            "required": [
              "module",
              "side"
            ],
            "properties": {
              "module": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "side": {
                "enum": [
                  "top",
                  "right",
                  "bottom",
                  "left"
                ]
              },
              "fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "offset": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "reason": {
                "type": "string"
              },
              "surface": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "additionalProperties": false
          },
          "to": {
            "type": "object",
            "required": [
              "module",
              "side"
            ],
            "properties": {
              "module": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "side": {
                "enum": [
                  "top",
                  "right",
                  "bottom",
                  "left"
                ]
              },
              "fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "offset": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "reason": {
                "type": "string"
              },
              "surface": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "additionalProperties": false
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "array",
                  "items": [
                    {
                      "const": "M"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 3,
                  "maxItems": 3,
                  "additionalItems": false
                },
                {
                  "type": "array",
                  "items": [
                    {
                      "const": "L"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 3,
                  "maxItems": 3,
                  "additionalItems": false
                },
                {
                  "type": "array",
                  "items": [
                    {
                      "const": "C"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 7,
                  "maxItems": 7,
                  "additionalItems": false
                },
                {
                  "type": "array",
                  "items": [
                    {
                      "const": "Q"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 5,
                  "maxItems": 5,
                  "additionalItems": false
                },
                {
                  "type": "array",
                  "items": [
                    {
                      "const": "Z"
                    }
                  ],
                  "minItems": 1,
                  "maxItems": 1,
                  "additionalItems": false
                }
              ]
            },
            "minItems": 1
          },
          "removeSourcePoints": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "stroke": {
            "type": "string",
            "pattern": "^(none|#[0-9A-Fa-f]{6})$"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "dashed": {
            "type": "boolean"
          },
          "startArrow": {
            "enum": [
              "none",
              "triangle",
              "stealth",
              "open",
              "diamond",
              "oval"
            ]
          },
          "endArrow": {
            "enum": [
              "none",
              "triangle",
              "stealth",
              "open",
              "diamond",
              "oval"
            ]
          },
          "arrowSize": {
            "enum": [
              "sm",
              "med",
              "lg"
            ]
          },
          "labelIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            }
          },
          "meaning": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "operator": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "anchorTolerance": {
            "type": "number"
          },
          "clearance": {
            "type": "number"
          },
          "lineCap": {
            "enum": [
              "round",
              "square",
              "butt"
            ]
          },
          "dashPattern": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "additionalProperties": false
      }
    },
    "primitives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "seq",
          "box",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "type": {
            "enum": [
              "path",
              "text"
            ]
          },
          "seq": {
            "type": "number"
          },
          "box": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "commands": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "array",
                  "items": [
                    {
                      "const": "M"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 3,
                  "maxItems": 3,
                  "additionalItems": false
                },
                {
                  "type": "array",
                  "items": [
                    {
                      "const": "L"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 3,
                  "maxItems": 3,
                  "additionalItems": false
                },
                {
                  "type": "array",
                  "items": [
                    {
                      "const": "C"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 7,
                  "maxItems": 7,
                  "additionalItems": false
                },
                {
                  "type": "array",
                  "items": [
                    {
                      "const": "Q"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 5,
                  "maxItems": 5,
                  "additionalItems": false
                },
                {
                  "type": "array",
                  "items": [
                    {
                      "const": "Z"
                    }
                  ],
                  "minItems": 1,
                  "maxItems": 1,
                  "additionalItems": false
                }
              ]
            },
            "minItems": 1
          },
          "fill": {
            "type": "string",
            "pattern": "^(none|#[0-9A-Fa-f]{6})$"
          },
          "stroke": {
            "type": "string",
            "pattern": "^(none|#[0-9A-Fa-f]{6})$"
          },
          "width": {
            "type": "number"
          },
          "dash": {
            "type": [
              "string",
              "null"
            ]
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fillRule": {
            "enum": [
              "evenodd",
              "nonzero"
            ]
          },
          "icon": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "text": {
            "type": "string"
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "font": {
            "type": "string"
          },
          "sourceFont": {
            "type": "string"
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bold": {
            "type": "boolean"
          },
          "italic": {
            "type": "boolean"
          },
          "angle": {
            "type": "number"
          },
          "nativeTracking": {
            "type": "number"
          },
          "replacedBy": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "lineCap": {
            "enum": [
              "round",
              "butt",
              "square"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "textBox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "padding": {
            "type": "number"
          },
          "placement": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "removedPrimitiveIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "ids",
          "reason"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 10
          },
          "geometryHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceReferenceSHA256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "code": {
                  "const": "opaque-label-occlusion"
                }
              },
              "required": [
                "code"
              ]
            },
            "then": {
              "required": [
                "geometryHash",
                "sourceReferenceSHA256"
              ],
              "properties": {
                "geometryHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "sourceReferenceSHA256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        ]
      }
    },
    "operations": {
      "type": "array"
    },
    "replacedMath": {
      "type": "array"
    },
    "layoutChanges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraObstacles": {
      "type": "array"
    },
    "gaps": {
      "type": "array"
    },
    "tolerance": {
      "type": "number"
    },
    "groupIcons": {
      "type": "boolean",
      "description": "Emit each icon as an independent semantic SVG/native PPTX group, without changing its logical module owner."
    },
    "cleanArrowTips": {
      "type": "boolean",
      "description": "Mask the shaft underneath closed SVG heads so a broad round cap cannot protrude through the pointed tip; keep full logical route and native head dimensions."
    }
  },
  "additionalProperties": false
}
