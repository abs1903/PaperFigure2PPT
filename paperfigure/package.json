{
  "name": "paperfigure-skill",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic, editable research architecture figures for Codex",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/*.browser.mjs",
    "examples": "node scripts/agent-examples.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/*.browser.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "fast-xml-parser": "5.3.6",
    "jszip": "3.10.1",
    "pdfkit": "0.17.2",
    "playwright": "1.62.1",
    "pptxgenjs": "4.0.1",
    "sharp": "0.34.5",
    "svg-to-pdfkit": "0.1.8"
  }
}
