{
  "version": "1.0",
  "title": "Vision-language model overview",
  "subtitle": "Project visual features into a language model; distinguish training supervision from inference.",
  "sources": [
    {
      "id": "method",
      "kind": "user-description",
      "locator": "method.md",
      "text": "# Vision-language model overview\n\nThis is an original illustrative architecture specification for testing PaperFigure, not a reproduction or a claim of research novelty.\n\nThe image is processed by a frozen vision encoder, which sends visual features to a trainable projector.\n\nThe projector maps visual features into visual tokens consumed by a decoder-only language model.\n\nThe text prompt is consumed by the same decoder-only language model.\n\nAt inference, the language model produces an answer.\n\nDuring training only, the language model predictions are consumed by a supervised loss. The loss is a supervision path, not an inference module.\n"
    }
  ],
  "claims": {
    "summary": "Project visual features into a language model; distinguish training supervision from inference.",
    "innovation": null,
    "baseline": null,
    "scope": "Illustrative system-level overview. Internal transformer layers, optimization details, and performance claims are outside scope."
  },
